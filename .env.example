# Credenciales de UAM Virtual
UAM_USERNAME="tu_codigo_o_correo_aqui"
UAM_PASSWORD="tu_contraseña_aqui"

# Zona horaria del horario de clases (critica fuera de tu PC: los runners de
# GitHub corren en UTC y sin esto se equivocan de hora y de dia)
APP_TIMEZONE="America/Managua"

# Rango del semestre (YYYY-MM-DD). Fuera de estas fechas el bot no revisa nada.
# Dejalos vacios si no quieres limitarlo.
SEMESTER_START="2026-08-24"
SEMESTER_END="2026-12-07"

# Navegador (Playwright)
# HEADLESS_MODE=True  -> navegador invisible (recomendado para segundo plano)
# HEADLESS_MODE=False -> ver el navegador (útil para depurar)
HEADLESS_MODE=True
BROWSER_TIMEOUT=30000

# Notificaciones por WhatsApp (número con código de país, sin "+" ni espacios)
WA_PHONE_NUMBER="505XXXXXXXX"

# Canal de aviso:
#   whatsapp_web -> WhatsApp Web con el perfil vinculado por QR (solo en tu PC)
#   callmebot    -> WhatsApp por API HTTP (funciona en GitHub Actions, pero
#                   depende de un servicio gratuito de terceros que se cae)
#   email        -> Gmail por SMTP (funciona en GitHub Actions, sin depender
#                   de nadie mas que tu propia cuenta; recomendado para la nube)
#   none         -> sin avisos, solo historial
NOTIFIER="whatsapp_web"

# Solo si NOTIFIER=callmebot. Para obtener la API key: agenda el +34 621 331 709
# y mandale por WhatsApp "I allow callmebot to send me messages".
CALLMEBOT_PHONE="505XXXXXXXX"
CALLMEBOT_APIKEY=""

# Solo si NOTIFIER=email. EMAIL_APP_PASSWORD es la "contraseña de aplicacion"
# de 16 caracteres (myaccount.google.com/apppasswords, requiere verificacion
# en 2 pasos activada), NO tu contraseña normal de Gmail. EMAIL_TO es opcional:
# si lo dejas vacio, el aviso se lo manda EMAIL_ADDRESS a si mismo.
EMAIL_ADDRESS="tu_correo@gmail.com"
EMAIL_APP_PASSWORD=""
EMAIL_TO=""
