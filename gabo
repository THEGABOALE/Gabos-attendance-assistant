#!/usr/bin/env bash
# Lanzador de la CLI en Linux/macOS o Git Bash. En Windows (CMD/PowerShell) usa gabo.cmd.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Preferimos el Python del entorno virtual del proyecto si existe.
VENV_PY="$SCRIPT_DIR/.venv/Scripts/python.exe"   # Windows (Git Bash)
[ -x "$VENV_PY" ] || VENV_PY="$SCRIPT_DIR/.venv/bin/python"   # Linux/macOS
[ -x "$VENV_PY" ] || VENV_PY="python"             # fallback al Python del PATH

export PYTHONPATH="$SCRIPT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV_PY" -m attendance_assistant.cli "$@"
